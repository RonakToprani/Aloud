# Supabase — create a project at https://supabase.com, then paste the values
# from Project Settings › API. Without these the app runs local-only: no
# sign-in, no sync, no counter. Copy to .env.local for development and add
# the same two variables to the Vercel project for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to true once the magic-link email template includes {{ .Token }} (see
# supabase/templates/magic_link.html; needs a custom SMTP provider). The
# sign-in screen then offers a code field for the home-screen app.
NEXT_PUBLIC_SUPABASE_EMAIL_CODE=false
